# Data directories
RAG_DATA_DIR=data
RAG_URLS_FILE=urls.txt

# Qdrant settings
RAG_QDRANT_PATH=.store
RAG_QDRANT_COLLECTION_NAME=rag

# Ollama URL
RAG_OLLAMA_BASE_URL=http://localhost:11434
# For Docker:
# RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM model
RAG_LLM_MODEL=hf.co/techwithsergiu/Qwen3.5-text-2B-GGUF:Q4_K_M

# Embedding model
RAG_EMBEDDING_MODEL=embeddinggemma:300m

# Generation parameters
RAG_TEMPERATURE=0.25
RAG_NUM_CTX=8192
RAG_NUM_PREDICT=512
RAG_REASONING=false
RAG_SEED=42
RAG_ASK_QUERY_K_LIMIT=4

# Chunking settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_SAVE_CHUNKS=false